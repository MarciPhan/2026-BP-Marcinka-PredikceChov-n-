# Metricord Config
# ----------------

# Discord (https://discord.com/developers/applications)
BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Must match a Redirect URI configured in the Discord app (OAuth2 tab), e.g.
# http://localhost:8093/auth/callback for local development.
DISCORD_REDIRECT_URI=http://localhost:8093/auth/callback
# Token for a second, lite-mode bot instance (BOT_LITE_MODE=1) used by the
# dev docker-compose.yml's discord-bot-dashboard service. Not needed for
# docker-compose.prod.yml, which does not run a second bot instance.
DASHBOARD_TOKEN=

# Discourse
DISCOURSE_TOKEN=

# Web Dashboard
DASHBOARD_PORT=8093
DASHBOARD_SECRET_KEY=
DASHBOARD_ACCESS_TOKEN=

# Infrastructure
REDIS_URL=redis://localhost:6379/0

# SMTP / Email
SMTP_PASSWORD=

# Analytics Config
EVENT_RETENTION_DAYS=90
ACTIVITY_INACTIVITY_THRESHOLD_DAYS=14
